[Unit]
Description=Personal Agent Runtime Planner
After=local-fs.target

[Service]
Type=simple
User=par-planner
Group=par-runtime
ExecStart=/opt/personal-agent-runtime/.venv/bin/par-runtime appliance-service --role planner --profile /etc/par/appliance_profile.json
Restart=on-failure
RuntimeDirectory=par
RuntimeDirectoryMode=0770
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/par /var/lib/par/planner

[Install]
WantedBy=multi-user.target
