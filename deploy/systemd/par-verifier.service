[Unit]
Description=Personal Agent Runtime Independent Verifier
After=local-fs.target

[Service]
Type=simple
User=par-verifier
Group=par-runtime
ExecStart=/opt/personal-agent-runtime/.venv/bin/par-runtime appliance-service --role verifier --profile /etc/par/appliance_profile.json
Restart=on-failure
RuntimeDirectory=par
RuntimeDirectoryMode=0770
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/par/appliance_profile.json /etc/par/verifier_trust.json /etc/par/secrets/verifier_receipt_signer.key
ReadWritePaths=/run/par /var/lib/par/verifier

[Install]
WantedBy=multi-user.target
