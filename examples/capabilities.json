  "version": "1",
  "grants": [
    {
      "grant_id": "echo",
      "capability": "tool.echo",
      "effect": "ALLOW",
      "actions": ["echo"],
      "resources": ["console"],
      "issued_by": "human"
    },
    {
      "grant_id": "files-read",
      "capability": "filesystem.read",
      "effect": "ALLOW",
