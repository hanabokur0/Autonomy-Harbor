{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/personal-agent-runtime/decision_contract.schema.json",
  "title": "Decision Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "root_node", "nodes", "authority_effect"],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "context_ref": {"type": ["string", "null"]},
    "root_node": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "statement", "responsibility"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "responsibility": {"enum": ["AI_PROP", "HUMAN_APP", "AUTO_EXEC"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "downstream_impacts": {"type": "array", "items": {"type": "string"}},
    "authority_effect": {"const": "NONE"}
  }
}
